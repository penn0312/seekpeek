# Required: your DeepSeek API key (https://platform.deepseek.com/api_keys)
# For local runs, copy this file to:
#   ~/.config/seekpeek/.env     (recommended: any host, any working directory)
#   ./.env                      (this checkout only)
# or point SEEKPEEK_ENV_FILE at wherever you keep it.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the API endpoint (proxy or gateway deployments)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: server tuning
# SEEKPEEK_TIMEOUT=60            # seconds, per HTTP request
# SEEKPEEK_MAX_RETRIES=2         # retries for 408 / 429 / 5xx
# SEEKPEEK_SEARCH_QPS=5          # account-level limit advertised by DeepSeek
# SEEKPEEK_FETCH_QPS=5
